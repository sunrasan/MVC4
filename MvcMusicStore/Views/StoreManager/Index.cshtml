@model IEnumerable<MvcMusicStore.Models.Album>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table>
    <tr>
        <th>Genre</th>
        <th>Artist</th>
        <th>Title</th>
        <th>Price</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @item.Genre?.Name
            </td>
            <td>
                @(item.Artist?.Name?.Length > 25 ? item.Artist.Name.Substring(0, 25) + "..." : item.Artist?.Name)
            </td>
            <td>
                @(item.Title?.Length > 25 ? item.Title.Substring(0, 25) + "..." : item.Title)
            </td>
            <td>
                @item.Price
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.AlbumId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.AlbumId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.AlbumId">Delete</a>
            </td>
        </tr>
    }
</table>
