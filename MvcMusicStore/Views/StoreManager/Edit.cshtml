@model MvcMusicStore.Models.Album

@{
    ViewBag.Title = "Edit";
}

<h2>Edit</h2>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <fieldset>
        <legend>Album</legend>

        <input asp-for="AlbumId" type="hidden" />

        <div class="editor-label">
            <label asp-for="GenreId">Genre</label>
        </div>
        <div class="editor-field">
            @Html.DropDownList("GenreId", String.Empty)
            <span asp-validation-for="GenreId" class="text-danger"></span>
        </div>

        <div class="editor-label">
            <label asp-for="ArtistId">Artist</label>
        </div>
        <div class="editor-field">
            @Html.DropDownList("ArtistId", String.Empty)
            <span asp-validation-for="ArtistId" class="text-danger"></span>
        </div>

        <div class="editor-label">
            <label asp-for="Title"></label>
        </div>
        <div class="editor-field">
            <input asp-for="Title" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="editor-label">
            <label asp-for="Price"></label>
        </div>
        <div class="editor-field">
            <input asp-for="Price" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="editor-label">
            <label asp-for="AlbumArtUrl"></label>
        </div>
        <div class="editor-field">
            <input asp-for="AlbumArtUrl" />
            <span asp-validation-for="AlbumArtUrl" class="text-danger"></span>
        </div>

        <p>
            <input type="submit" value="Save" />
        </p>
    </fieldset>
</form>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
