@model ICollection<MvcMusicStore.Models.ExternalLogin>

@if (Model.Count > 0)
{
    <h3>Registered external logins</h3>
    <table>
        <tbody>
            @foreach (var externalLogin in Model)
            {
                <tr>
                    <td>@externalLogin.ProviderDisplayName</td>
                    <td>
                        @if (ViewBag.ShowRemoveButton == true)
                        {
                            <form asp-action="Disassociate" asp-controller="Account" method="post">
                                @Html.AntiForgeryToken()
                                <fieldset>
                                    <input type="hidden" name="provider" value="@externalLogin.Provider" />
                                    <input type="hidden" name="providerUserId" value="@externalLogin.ProviderUserId" />
                                    <input type="submit" value="Remove"
                                           title="Remove this @externalLogin.ProviderDisplayName credential from your account" />
                                </fieldset>
                            </form>
                        }
                        else
                        {
                            @:&nbsp;
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
