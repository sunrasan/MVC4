@model IEnumerable<Microsoft.AspNetCore.Authentication.AuthenticationScheme>

@if (!Model.Any())
{
    <div class="message-info">
        <p>There are no external authentication services configured.</p>
    </div>
}
else
{
    <form asp-action="ExternalLogin" asp-controller="Account"
          asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
        @Html.AntiForgeryToken()
        <fieldset id="socialLoginList">
            <legend>Log in using another service</legend>
            <p>
                @foreach (var scheme in Model)
                {
                    <button type="submit" name="provider" value="@scheme.Name"
                            title="Log in using your @scheme.DisplayName account">
                        @scheme.DisplayName
                    </button>
                }
            </p>
        </fieldset>
    </form>
}
