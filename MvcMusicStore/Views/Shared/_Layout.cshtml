<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - MVC Music Store</title>
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <meta name="viewport" content="width=device-width" />
    @* Replaced @Styles.Render("~/Content/css") with direct link tag (issue-19) *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div class="content-wrapper">
            <div class="float-left">
                <p class="site-title">
                    <a asp-controller="Home" asp-action="Index">ASP.NET MVC Music Store</a>
                </p>
            </div>
            <div class="float-right">
                <section id="login">
                    <partial name="_LoginPartial" />
                </section>
                <nav>
                    <ul id="menu">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Store" asp-action="Index">Store</a></li>
                        @* Replaced @Html.Action("CartSummary", "ShoppingCart") with ViewComponent (issue-14, issue-20) *@
                        @await Component.InvokeAsync("CartSummary")
                    </ul>
                </nav>
            </div>
        </div>
    </header>
    <div id="body">
        @* Replaced @Html.Action("GenreMenu", "Store") with ViewComponent (issue-15, issue-20) *@
        @await Component.InvokeAsync("GenreMenu")
        @RenderSection("featured", required: false)
        <section class="content-wrapper main-content clear-fix">
            @RenderBody()
        </section>
    </div>
    <footer>
        <div class="content-wrapper">
            <div class="float-left">
                <p><a href="http://mvcmusicstore.codeplex.com">mvcmusicstore.codeplex.com</a></p>
            </div>
            <div class="float-right">
                <p><a asp-controller="StoreManager" asp-action="Index">Admin</a></p>
            </div>
        </div>
    </footer>

    @* Replaced @Scripts.Render("~/bundles/jquery") with direct script tag (issue-19) *@
    <script src="~/js/jquery.min.js" asp-append-version="true"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
